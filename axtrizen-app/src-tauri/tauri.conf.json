{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Axtrizen AI",
  "version": "0.1.0",
  "identifier": "com.axtrizen.ai",
  "build": {
    "beforeBuildCommand": "cd ../../axtrizenFrontEnd && npm run build",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../../axtrizenFrontEnd/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Axtrizen AI",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
