{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Axtrizen AI",
  "version": "0.1.0",
  "identifier": "com.axtrizen.ai",
  "build": {
    "beforeBuildCommand": "cd ../axtrizenFrontEnd && npm run build",
    "beforeDevCommand": "cd ../axtrizenFrontEnd && npm run dev -- --port 5174",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../../axtrizenFrontEnd/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Axtrizen AI",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ws://127.0.0.1:* http://127.0.0.1:* https://*.anthropic.com https://*.openai.com; img-src 'self' data: blob:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Multi-Agent AI Orchestration Platform",
    "longDescription": "Axtrizen AI is a desktop application for orchestrating, monitoring, and managing multiple AI agents with enterprise-grade controls, usage tracking, and memory-augmented intelligence.",
    "copyright": "© 2025 Axtrizen AI",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "frameworks": [],
      "exceptionDomain": "",
      "signingIdentity": null,
      "entitlements": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libsoup-3.0-0",
          "libjavascriptcoregtk-4.1-0"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
